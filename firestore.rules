rules_version = '2';

// This app has no client-side Firestore access — every read/write goes
// through the Admin SDK on the server (see src/server/firebase/client.ts),
// which bypasses these rules entirely. This deny-all exists only because
// the Firebase CLI/emulator require a rules file to boot; it documents
// that nothing should ever reach Firestore except via the Admin SDK.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
